# Example .env for openclawgotchi
# Copy this file to .env and fill in your values

# === Bot ===
BOT_PLATFORM=discord
# TELEGRAM_BOT_TOKEN=your_telegram_token
# DISCORD_BOT_TOKEN=your_discord_token

# === Access Control ===
# ALLOWED_USERS=123456,789012
# ALLOWED_GROUPS=111111,222222
# ALLOW_ALL_USERS=true

# === Pwnagotchi / Bettercap ===
# BETTERCAP_URL=http://localhost:8081/api
# BETTERCAP_USER=pwnagotchi
# BETTERCAP_PASS=pwnagotchi
# BETTERCAP_API_USER=gotchi
# BETTERCAP_API_PASS=
# PWN_WHITELIST_MACS=aa:bb:cc:dd:ee:ff,11:22:33:44:55:66
# Comma-separated list of SSIDs to never deauth
#SSID_WHITELIST=MyHomeWiFi,GuestNetwork

# === Hardware ===
# MOCK_HARDWARE=false
# HUNT_ON_BOOT=false

# === LLM ===
# DEFAULT_LITE_PRESET=gemini
# DEFAULT_LITE_MODEL=gemini-1.5-flash-latest
# DEFAULT_PRO_PRESET=gemini
# DEFAULT_PRO_MODEL=gemini-1.5-pro-latest
# GEMINI_MODEL=google/gemini-flash-latest
# CLAUDE_TIMEOUT=600
# HISTORY_LIMIT=50
# BOT_LANGUAGE=en
